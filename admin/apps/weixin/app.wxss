page {
  --primary: #1677FF;
  --primary-light: rgba(22, 119, 255, 0.1);
  --success: #52C41A;
  --warning: #FAAD14;
  --danger: #FF4D4F;
  --text-primary: #262626;
  --text-secondary: #8C8C8C;
  --text-disabled: #BFBFBF;
  --bg-page: #f5f5f5;
  --bg-white: #ffffff;
  --border-color: #f0f0f0;
  --radius: 8rpx;

  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.card {
  background: var(--bg-white);
  border-radius: var(--radius);
  padding: 24rpx;
  margin: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  background-color: var(--primary);
  color: #fff;
  border-radius: 6rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
}

.btn-danger {
  background-color: var(--danger);
  color: #fff;
  border-radius: 6rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
}

.btn-outline {
  background-color: transparent;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 6rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-1 { flex: 1; }

.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-16 { margin-right: 16rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }

.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-center { text-align: center; }
.text-bold { font-weight: 600; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 40rpx; }

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.tag-success {
  background-color: rgba(82, 196, 26, 0.15);
  color: var(--success);
}

.tag-danger {
  background-color: rgba(255, 77, 79, 0.15);
  color: var(--danger);
}

.table-row {
  display: flex;
  flex-direction: row;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid var(--border-color);
  align-items: center;
}

.table-header {
  background-color: #fafafa;
  font-weight: 600;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.search-bar {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 6rpx;
  padding: 12rpx 16rpx;
  margin: 16rpx;
}

.search-bar input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--text-secondary);
}

.loading-center {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}
