page { background: #f5f5f5; font-size: 28rpx; color: #333; }
.container { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.btn-primary { background: #e74c3c; color: #fff; border-radius: 8rpx; padding: 20rpx; text-align: center; font-size: 32rpx; }
.btn-default { background: #fff; color: #333; border-radius: 8rpx; padding: 20rpx; text-align: center; font-size: 32rpx; border: 1rpx solid #ddd; }
.text-primary { color: #e74c3c; }
.text-gray { color: #999; }
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-column { display: flex; flex-direction: column; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.mt-20 { margin-top: 20rpx; }
.mb-20 { margin-bottom: 20rpx; }
