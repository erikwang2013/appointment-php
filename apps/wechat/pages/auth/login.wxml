<view class="page">
  <view class="logo-area flex-center">
    <text class="app-name">预约服务</text>
    <text class="app-desc">专业上门服务预约平台</text>
  </view>

  <view class="form-card card">
    <view class="mode-tabs flex-row">
      <view class="mode-tab {{mode === 'password' ? 'active' : ''}}" data-mode="password" bindtap="switchMode">密码登录</view>
      <view class="mode-tab {{mode === 'code' ? 'active' : ''}}" data-mode="code" bindtap="switchMode">验证码登录</view>
    </view>

    <view class="input-group">
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="inputPhone" />
    </view>

    <view class="input-group" wx:if="{{mode === 'password'}}">
      <input class="input" type="password" placeholder="请输入密码" value="{{password}}" bindinput="inputPassword" />
    </view>

    <view class="input-group flex-row" wx:if="{{mode === 'code'}}">
      <input class="input flex-1" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="inputCode" />
      <view class="code-btn" bindtap="sendCode">获取验证码</view>
    </view>

    <view class="privacy-row flex-row" bindtap="toggleAgree">
      <view class="checkbox {{agreePrivacy ? 'checked' : ''}}"></view>
      <text>已阅读并同意《用户协议》和《隐私政策》</text>
    </view>

    <view class="btn-primary login-btn" bindtap="doLogin">登录</view>

    <view class="link-row flex-between">
      <text bindtap="goRegister">注册账号</text>
      <text bindtap="goForgetPassword">忘记密码</text>
    </view>
  </view>

  <view class="wechat-login flex-center" bindtap="wechatLogin">
    <text>微信一键登录</text>
  </view>

  <view class="guest-entry" bindtap="guestEntry">
    <text>暂不登录，先看看</text>
  </view>
</view>
