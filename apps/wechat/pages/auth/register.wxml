<view class="page">
  <view class="form-card card">
    <text class="form-title">注册账号</text>

    <view class="input-group">
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="inputPhone" />
    </view>

    <view class="input-group flex-row">
      <input class="input flex-1" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="inputCode" />
      <view class="code-btn" bindtap="sendCode">获取验证码</view>
    </view>

    <view class="input-group">
      <input class="input" type="password" placeholder="请输入密码（6-20位）" value="{{password}}" bindinput="inputPassword" />
    </view>

    <view class="input-group">
      <input class="input" type="password" placeholder="请确认密码" value="{{confirmPassword}}" bindinput="inputConfirmPassword" />
    </view>

    <view class="input-group">
      <input class="input" type="text" placeholder="推荐码（选填）" value="{{referralCode}}" bindinput="inputReferral" />
    </view>

    <view class="privacy-row flex-row" bindtap="toggleAgree">
      <view class="checkbox {{agreePrivacy ? 'checked' : ''}}"></view>
      <text>已阅读并同意《用户协议》和《隐私政策》</text>
    </view>

    <view class="btn-primary login-btn" bindtap="doRegister">注册</view>

    <view class="link-row flex-center" bindtap="goLogin">
      <text>已有账号？去登录</text>
    </view>
  </view>
</view>
