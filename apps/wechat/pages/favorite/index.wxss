.container { padding: 20rpx; background: #f6f7f9; min-height: 100vh; }

.fav-item { display: flex; align-items: center; }
.fav-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; background: #f0f0f0; }
.fav-img-empty { display: flex; align-items: center; justify-content: center; font-size: 48rpx; }
.fav-body { flex: 1; min-width: 0; margin-left: 20rpx; }
.fav-title { font-size: 30rpx; font-weight: bold; display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.fav-sub { color: #999; font-size: 24rpx; display: block; margin-top: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.fav-type { color: #e74c3c; font-size: 20rpx; background: #fdf0ee; border-radius: 6rpx; padding: 2rpx 10rpx; display: inline-block; margin-top: 8rpx; }
.unfav-btn { flex-shrink: 0; margin-left: 16rpx; color: #e74c3c; font-size: 24rpx; }

.empty { text-align: center; padding: 160rpx 0; }
.empty-icon { font-size: 80rpx; display: block; }
.empty-text { color: #999; font-size: 28rpx; margin-top: 20rpx; display: block; }

.load-more { text-align: center; color: #b0b0b0; font-size: 24rpx; padding: 20rpx 0 40rpx; }
