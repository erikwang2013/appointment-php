<view class="container">
  <view class="card">
    <view class="form-head">
      <text class="form-label">反馈内容</text>
      <text class="form-count">{{content.length}}/{{maxLen}}</text>
    </view>
    <textarea
      class="form-textarea"
      placeholder="请描述您遇到的问题或建议（最多1000字）"
      maxlength="{{maxLen}}"
      value="{{content}}"
      bindinput="onInput"
    />
  </view>
  <view class="btn-primary" bindtap="onSubmit">提交反馈</view>
  <text class="submit-tip">您的反馈将帮助我们改进服务</text>
</view>
