.container { padding: 20rpx; background: #f6f7f9; min-height: 100vh; }

.form-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.form-label { font-size: 28rpx; font-weight: bold; }
.form-count { color: #b0b0b0; font-size: 24rpx; }
.form-textarea {
  width: 100%;
  height: 300rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
.submit-tip { display: block; text-align: center; color: #b0b0b0; font-size: 24rpx; margin-top: 16rpx; }
