.page { padding-bottom: 20rpx; }
.banner { width: 100%; height: 360rpx; }
.banner-img { width: 100%; height: 100%; }
.notice-bar { background: #fff; padding: 16rpx 24rpx; margin: 16rpx 20rpx; border-radius: 12rpx; }
.notice-icon { margin-right: 12rpx; font-size: 28rpx; }
.notice-swiper { flex: 1; height: 40rpx; }
.notice-text { font-size: 26rpx; color: #e74c3c; }
.section { margin: 24rpx 20rpx; }
.section-title { font-size: 32rpx; font-weight: bold; margin-bottom: 16rpx; display: block; }
.category-grid { display: flex; flex-wrap: wrap; }
.category-item { width: 25%; padding: 20rpx 0; }
.category-icon { width: 80rpx; height: 80rpx; margin-bottom: 8rpx; }
.category-name { font-size: 24rpx; color: #666; }
.service-scroll { width: 100%; }
.scroll-x { white-space: nowrap; }
.service-card { display: inline-block; width: 280rpx; margin-right: 20rpx; white-space: normal; }
.service-card:last-child { margin-right: 0; }
.service-img { width: 100%; height: 200rpx; border-radius: 12rpx; }
.service-name { display: block; margin-top: 12rpx; font-size: 28rpx; font-weight: 500; }
.service-price { display: block; margin-top: 8rpx; font-size: 32rpx; font-weight: bold; }
