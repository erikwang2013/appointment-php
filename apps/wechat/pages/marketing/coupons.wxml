<view>
  <view class="tabs">
    <text wx:for="{{['可用','已用','过期']}}" class="tab {{activeTab===index?'active':''}}" bindtap="onTabChange" data-index="{{index}}">{{item}}</text>
  </view>
  <block wx:for="{{coupons}}" wx:key="id">
    <view class="card coupon-card"><view class="coupon-amount">¥{{item.amount}}</view><view class="coupon-info"><text>{{item.name}}</text><text class="coupon-date">{{item.start_at}} - {{item.end_at}}</text></view></view>
  </block>
  <view wx:if="{{coupons.length===0}}" class="empty">暂无优惠券</view>
</view>
