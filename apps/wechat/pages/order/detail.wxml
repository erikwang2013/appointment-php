<view class="container" wx:if="{{order}}">
  <view class="card"><text class="status-text">订单状态: {{order.status}}</text></view>
  <view class="card"><text>订单编号: {{order.order_no}}</text><text>下单时间: {{order.created_at}}</text><text>实付金额: ¥{{order.paid_amount}}</text></view>
  <view class="card" wx:if="{{order.store}}"><text>门店: {{order.store.name}}</text><text>地址: {{order.store.address}}</text></view>
  <view class="card" wx:if="{{order.technician}}"><text>技师: {{order.technician.name}}</text></view>
  <view class="card" wx:if="{{order.remark}}"><text>备注: {{order.remark}}</text></view>
  <view class="actions">
    <button wx:if="{{order.status==='pending'}}" bindtap="onPay">去支付</button>
    <button wx:if="{{order.status==='pending' || order.status==='paid'}}" bindtap="onCancel">取消订单</button>
    <button wx:if="{{order.status==='paid'}}" bindtap="onRefund">申请退款</button>
  </view>
</view>
