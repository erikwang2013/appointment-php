.tabs { white-space: nowrap; background: #fff; padding: 20rpx; }
.tab { display: inline-block; padding: 12rpx 28rpx; margin-right: 16rpx; border-radius: 20rpx; background: #f5f5f5; }
.tab.active { background: #e74c3c; color: #fff; }
.order-header { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.status { color: #e74c3c; }
.order-item { display: flex; gap: 16rpx; padding: 12rpx 0; border-top: 1px solid #f0f0f0; }
.order-img { width: 100rpx; height: 100rpx; border-radius: 8rpx; }
.order-info { flex: 1; }
.order-footer { text-align: right; font-weight: bold; padding-top: 12rpx; border-top: 1px solid #f0f0f0; }
.price { color: #e74c3c; display: block; }
