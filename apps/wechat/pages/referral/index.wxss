.container { padding: 20rpx; background: #f6f7f9; min-height: 100vh; }

.code-card { display: flex; align-items: center; flex-wrap: wrap; }
.code-label { color: #999; font-size: 26rpx; width: 100%; margin-bottom: 12rpx; }
.code-value { font-size: 44rpx; font-weight: bold; letter-spacing: 4rpx; flex: 1; }
.copy-btn { color: #e74c3c; font-size: 24rpx; }

.stats-card { display: flex; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: bold; color: #e74c3c; display: block; }
.stat-label { color: #999; font-size: 24rpx; display: block; margin-top: 8rpx; }

.link-head { display: flex; justify-content: space-between; align-items: center; }
.link-label { font-size: 28rpx; font-weight: bold; }
.link-url { display: block; color: #555; font-size: 26rpx; margin-top: 16rpx; word-break: break-all; }
.link-tip { display: block; color: #b0b0b0; font-size: 22rpx; margin-top: 12rpx; }

.referred-head { display: flex; justify-content: space-between; align-items: center; }
.referred-title { font-size: 28rpx; font-weight: bold; }
.referred-count { color: #b0b0b0; font-size: 24rpx; }
.referred-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.referred-item:last-child { border-bottom: none; padding-bottom: 0; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #f0f0f0; flex-shrink: 0; }
.avatar-empty { display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.referred-body { flex: 1; min-width: 0; margin-left: 16rpx; }
.referred-name { font-size: 28rpx; display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.referred-time { color: #b0b0b0; font-size: 22rpx; display: block; margin-top: 4rpx; }
.referred-right { text-align: right; flex-shrink: 0; margin-left: 12rpx; }
.order-badge { font-size: 20rpx; border-radius: 6rpx; padding: 2rpx 10rpx; }
.order-badge.ok { color: #07c160; background: #e8f9f0; }
.order-badge.pending { color: #999; background: #f0f0f0; }
.reward-text { color: #e74c3c; font-size: 22rpx; display: block; margin-top: 6rpx; }
.referred-empty { color: #b0b0b0; font-size: 26rpx; text-align: center; padding: 40rpx 0 10rpx; }

.load-more { text-align: center; color: #b0b0b0; font-size: 24rpx; padding: 20rpx 0 40rpx; }
