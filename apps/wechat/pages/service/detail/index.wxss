.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 140rpx; }
.card { background: #fff; border-radius: 16rpx; margin: 20rpx; padding: 24rpx; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.text-gray { color: #999; }
.flex-center { display: flex; justify-content: center; align-items: center; }

.banner { width: 100%; height: 360rpx; display: block; }
.name { font-size: 34rpx; font-weight: bold; }
.price { font-size: 36rpx; color: #e74c3c; font-weight: bold; }
.desc { display: block; margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; }
.meta { display: block; margin-top: 8rpx; font-size: 24rpx; }

.row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.row:last-child { border-bottom: none; }
.row-label { font-size: 28rpx; color: #333; }
.row-value { font-size: 28rpx; color: #333; }
.row-value.selected { color: #e74c3c; }
.row-value.placeholder { color: #999; }

.remark { width: 100%; height: 160rpx; font-size: 28rpx; margin-top: 12rpx; }

.empty { padding: 120rpx 0; font-size: 28rpx; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06); }
.btn-primary { background: #e74c3c; color: #fff; font-size: 32rpx; border-radius: 44rpx; }
