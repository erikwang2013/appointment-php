.user-header { display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; }
.user-info { flex: 1; }
.nickname { font-size: 36rpx; font-weight: bold; display: block; }
.phone { color: #999; }
.menu-grid { display: flex; flex-wrap: wrap; }
.menu-item { width: 25%; text-align: center; padding: 20rpx 0; }
.menu-icon { font-size: 48rpx; display: block; margin-bottom: 8rpx; }
.entry-row { display: flex; align-items: center; padding: 28rpx 24rpx; }
.entry-icon { font-size: 40rpx; margin-right: 20rpx; }
.entry-name { flex: 1; font-size: 30rpx; }
.entry-arrow { color: #c0c0c0; font-size: 40rpx; }
/* 品牌页脚：吉祥物「预约小兔」 */
.brand-footer { display: flex; flex-direction: column; align-items: center; padding: 30rpx 0 10rpx; }
.brand-footer .mascot { width: 144rpx; height: 144rpx; opacity: .9; }
.brand-footer .brand-name { font-size: 24rpx; color: #999; margin-top: 8rpx; }
