# ============================================================
# 预约服务系统 — Docker 环境变量
# Copyright (c) 2026 erik <erik@erik.xyz> — https://erik.xyz
# ============================================================

# ── 应用配置 ──
APP_NAME=预约服务系统
APP_DEBUG=false
APP_URL=http://localhost

# ── JWT 认证 ──
JWT_SECRET_KEY=change-me-to-64-char-random-string
JWT_ALGORITHM=HS256
JWT_DEFAULT_EXPIRE=7200
JWT_REFRESH_EXPIRE=1209600
JWT_ISSUER=appointment-service
JWT_AUDIENCE=appointment-service

# ── Hashids ──
HASHIDS_SALT=change-me-to-random-salt
HASHIDS_ALT_SALT=change-me-to-another-salt

# ── Snowflake ──
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_START_TIMESTAMP=1700000000000

# ── 加密 ──
ENCRYPTION_KEY=change-me-to-32-byte-random-key
ENCRYPTION_CIPHER=AES-256-CBC
ENCRYPTION_IV=
ENCRYPTABLE_KEY=change-me-to-32-byte-random-key
ENCRYPTABLE_CIPHER=AES-256-CBC
ENCRYPTION_PREVIOUS_KEYS=

# ── Elasticsearch ──
SCOUT_DRIVER=elasticsearch
SCOUT_HOSTS=http://elasticsearch:9200
SCOUT_PREFIX=appointment_

# ── 验证码 ──
POSTER_IMAGE_DRIVER=gd
POSTER_IMAGE_QUALITY=90
POSTER_CAPTCHA_STORAGE=redis
POSTER_CAPTCHA_TTL=300
POSTER_CAPTCHA_MAX_ATTEMPTS=3
POSTER_CAPTCHA_DIFFICULTY=medium

# ── CORS 跨域 ──
# Docker 部署时设为 Nginx 域名，如 https://api.example.com
CORS_ALLOW_ORIGIN=

# ── 数据库 ──
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=appointment
DB_USERNAME=root
DB_PASSWORD=root

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
