APP_ENV=dev
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appointment
DB_USERNAME=root
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# JWT密钥（生产环境务必修改）
JWT_SECRET_KEY=appointment-service-jwt-secret-change-in-production
# API敏感数据加密密钥
ENCRYPTION_KEY=appointment-service-encryption-key-change-in-production
# 数据库敏感字段加密密钥（独立于API层）
ENCRYPTABLE_KEY=appointment-service-encryptable-key-change-in-production
# Hashids盐值（ID加解密）
HASHIDS_SALT=appointment-service-hashids-change-in-production
